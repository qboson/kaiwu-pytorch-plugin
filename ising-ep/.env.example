# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Credentials come from your Kaiwu account on the quantum cloud platform
# (https://platform.qboson.com/) under the SDK authorization page.
#
# Kaiwu 1.4 asks for these before the first anneal, including the classical
# simulated annealer. Kaiwu 1.3.1 does not, so on 1.3.1 you can leave the file
# absent and still run `examples/digits_kaiwu` and `examples/mnist_kaiwu`.
#
# Environment variables take precedence over this file, so a shell export wins.

KAIWU_USER_ID=
KAIWU_SDK_CODE=
