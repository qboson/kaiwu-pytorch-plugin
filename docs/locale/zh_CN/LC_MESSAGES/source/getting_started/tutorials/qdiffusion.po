msgid "Key training details:"
msgstr "关键训练细节："

#: ../../source/getting_started/tutorials/qdiffusion.md:187
msgid "Proposal model: frozen, produces logits"
msgstr "提议模型：冻结，生成 logits"

#: ../../source/getting_started/tutorials/qdiffusion.md:188
msgid "Energy reranker: trainable, scores candidates"
msgstr "能量重排序器：可训练，为候选序列打分"

