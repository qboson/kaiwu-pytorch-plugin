msgstr "用户类型"

#: ../../../../Users/chang137/Documents/kaiwu_torch_plugin_docs/docs/source/getting_started/introduction.md:276
msgid "Use Case"
msgstr "用例"

#: ../../../../Users/chang137/Documents/kaiwu_torch_plugin_docs/docs/source/getting_started/introduction.md:277
