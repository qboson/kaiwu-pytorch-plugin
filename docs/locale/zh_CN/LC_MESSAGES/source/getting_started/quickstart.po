msgid "**BM**"
msgstr "**BM**"

#: ../../source/getting_started/quickstart.md:52
msgid "Topology"
msgstr "拓扑结构"

#: ../../source/getting_started/quickstart.md:52
msgid "Bipartite"
msgstr "二部图"

#: ../../source/getting_started/quickstart.md:52
msgid "Fully connected"
msgstr "全连接"

#: ../../source/getting_started/quickstart.md:52
msgid "Positive phase"
msgstr "正相"

#: ../../source/getting_started/quickstart.md:52
msgid "`get_hidden(x, bernoulli=True)`"
msgstr "`get_hidden(x, bernoulli=True)`"

#: ../../source/getting_started/quickstart.md:52
msgid "`condition_sample(sampler, x)`"
msgstr "`condition_sample(sampler, x)`"

