#: ../../source/getting_started/quickstart.md:16
msgid "**1. Positive Phase (PyTorch)**"
msgstr "**1. 正相（PyTorch）**"

#: ../../source/getting_started/quickstart.md:16
msgid "Compute hidden activations from data"
msgstr "从数据计算隐藏层激活"

#: ../../source/getting_started/quickstart.md:16
msgid "`h = rbm.get_hidden(x, bernoulli=True)`"
msgstr "`h = rbm.get_hidden(x, bernoulli=True)`"

#: ../../source/getting_started/quickstart.md:16
msgid "**2. Negative Phase (SDK)**"
msgstr "**2. 负相（SDK）**"

#: ../../source/getting_started/quickstart.md:16
msgid "Sample from model distribution, offloaded to SA/CIM"
msgstr "从模型分布采样，卸载到 SA/CIM"

#: ../../source/getting_started/quickstart.md:16
msgid "`s = rbm.sample(sampler)`"
msgstr "`s = rbm.sample(sampler)`"

#: ../../source/getting_started/quickstart.md:16
msgid "**3. Objective & Update (PyTorch)**"
msgstr "**3. 目标函数与更新（PyTorch）**"

#: ../../source/getting_started/quickstart.md:16
msgid "Compute objective, backpropagate, update parameters"
msgstr "计算目标函数、反向传播、更新参数"

#: ../../source/getting_started/quickstart.md:16
msgid "`objective = rbm.objective(h, s)` → `backward()` → `optimizer.step()`"
msgstr "`objective = rbm.objective(h, s)` → `backward()` → `optimizer.step()`"

#: ../../source/getting_started/quickstart.md:50
msgid "Code Entity Mapping"
msgstr "代码实体映射"

#: ../../source/getting_started/quickstart.md:75
msgid "**Mapping Walkthrough:**"
msgstr "**映射详解：**"

#: ../../source/getting_started/quickstart.md:77
msgid ""
"**Model Logic:** BM/RBM holds `quadratic_coef` (W) and `linear_bias` (b,c)"
msgstr "**模型逻辑：** BM/RBM 持有 `quadratic_coef`（W）和 `linear_bias`（b,c）"

#: ../../source/getting_started/quickstart.md:78
msgid ""
"**Ising Conversion:** `_to_ising_matrix()` converts W,b,c into "
"Ising J (coupling) and h (field) matrix"
msgstr "**伊辛转换：** `_to_ising_matrix()` 将 W,b,c 转换为伊辛 J（耦合）和 h（场）矩阵"

#: ../../source/getting_started/quickstart.md:79
msgid ""
"**Sampling Interface:** `model.sample(sampler)` passes J,h to the "
"sampler's `solve()` method"
msgstr "**采样接口：** `model.sample(sampler)` 将 J,h 传递给采样器的 `solve()` 方法"

#: ../../source/getting_started/quickstart.md:80
msgid "**SDK Backend:**"
msgstr "**SDK 后端：**"

#: ../../source/getting_started/quickstart.md:81
msgid "Classical: `SimulatedAnnealingOptimizer`"
msgstr "经典：`SimulatedAnnealingOptimizer`"

#: ../../source/getting_started/quickstart.md:82
msgid "Quantum: `CIMOptimizer`"
msgstr "量子：`CIMOptimizer`"

#: ../../source/getting_started/quickstart.md:83
msgid "BM vs RBM: Key API Difference"
msgstr "BM 与 RBM：关键 API 差异"

