msgid "模块手册"
msgstr "模块手册"

#: ../../../../Users/chang137/Documents/kaiwu_torch_plugin_docs/docs/source/modules/kaiwu.torch_plugin.md:3
msgid "Module contents"
msgstr "模块内容"

#: kaiwu.torch_plugin:1 of
msgid "玻尔兹曼机"
msgstr "玻尔兹曼机"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine:1
#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine:1
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:1
#: of
msgid "基类：:py:class:`~kaiwu.torch_plugin.abstract_boltzmann_machine.AbstractBoltzmannMachine`"
msgstr "基类：:py:class:`~kaiwu.torch_plugin.abstract_boltzmann_machine.AbstractBoltzmannMachine`"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine:1 of
msgid "Boltzmann Machine."
msgstr "玻尔兹曼机。"

#: ../../../../Users/chang137/Documents/kaiwu_torch_plugin_docs/docs/source/modules/kaiwu.torch_plugin.md
msgid "参数"
msgstr "参数"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine:3 of
msgid "Total number of nodes in the model."
msgstr "模型中的节点总数。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine:5 of
msgid "quadratic coefficent,"
msgstr "二次项系数"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine:8 of
msgid "shape is [num_nodes, num_nodes]"
msgstr "形状为 [num_nodes, num_nodes]。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine:10 of
msgid ""
"linear_bias (torch.FloatTensor, optional): linear bias, shape is "
"[num_nodes]"
msgstr "linear_bias（torch.FloatTensor，可选）：线性偏置，形状为 [num_nodes]。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine:12 of
msgid ""
"device (torch.device, optional): Device for tensor construction. If "
"``None``, uses CPU."
msgstr "device（torch.device，可选）：用于张量构建的设备。若为 ``None``，则使用 CPU。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.clip_parameters:1
#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine.clip_parameters:1
#: of
msgid "Clip linear and quadratic bias weights in-place."
msgstr "原地裁剪线性和二次偏置权重。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.clip_parameters:3
#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine.clip_parameters:3
#: of
msgid "Range for quadratic weights. for example, [-1, 1]"
msgstr "二次项权重的范围，例如 [-1, 1]。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.clip_parameters:5
#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine.clip_parameters:5
#: of
msgid "Range for linear weights. for example, [-1, 1]"
msgstr "线性权重的范围，例如 [-1, 1]。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.condition_sample:1
#: of
msgid "Sample from the Boltzmann Machine given some nodes."
msgstr "在给定部分节点的条件下从玻尔兹曼机中采样。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.condition_sample:3
#: of
msgid "Optimizer used for sampling from the model."
msgstr "用于从模型中采样的优化器。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.condition_sample:5
#: of
msgid "State of the visible layer."
msgstr "可见层状态。"

#: ../../../../Users/chang137/Documents/kaiwu_torch_plugin_docs/docs/source/modules/kaiwu.torch_plugin.md
msgid "返回"
msgstr "返回"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.condition_sample:7
#: of
msgid ""
"Spins sampled from the model     (shape determined by ``sampler`` and "
"``sample_params``)."
msgstr "从模型中采样的自旋（形状由 ``sampler`` 和 ``sample_params`` 决定）。"

#: ../../../../Users/chang137/Documents/kaiwu_torch_plugin_docs/docs/source/modules/kaiwu.torch_plugin.md
msgid "返回类型"
msgstr "返回类型"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.forward:1
#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine.forward:1
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.energy:1
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.forward:1
#: of
msgid "Compute the Hamiltonian."
msgstr "计算哈密顿量。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.forward:3 of
msgid ""
"Tensor of shape (B, N), where B is batch size, N is the number of "
"variables in the model."
msgstr "形状为 (B, N) 的张量，其中 B 是批次大小，N 是模型中的变量数。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.forward:7
#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine.forward:7
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.energy:10
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.forward:7
#: of
msgid "Hamiltonian of shape (B,)."
msgstr "形状为 (B,) 的哈密顿量。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.gibbs_sample:1 of
msgid "Sample from the Boltzmann Machine."
msgstr "从玻尔兹曼机中采样。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.gibbs_sample:3 of
msgid "Number of Gibbs sampling steps."
msgstr "吉布斯采样步数。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.gibbs_sample:5 of
msgid ""
"State of the visible layer, shape (B, num_visible). If ``None``, randomly"
" initialize visible layer."
msgstr "可见层状态，形状为 (B, num_visible)。若为 ``None``，则随机初始化可见层。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.gibbs_sample:8 of
msgid "Number of samples. If ``None``, uses batch size of s_visible."
msgstr "样本数量；若为 ``None``，则使用 s_visible 的批次大小。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.hidden_bias:1 of
msgid "Get the hidden bias."
msgstr "获取隐藏层偏置。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.hidden_bias:3 of
msgid "Number of hidden nodes."
msgstr "隐藏节点数。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.symmetrized_quadratic_coef:1
#: of
msgid "Quadratic coefficient"
msgstr "二次项系数"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.visible_bias:1 of
msgid "Get the visible bias."
msgstr "获取可见层偏置。"

#: kaiwu.torch_plugin.full_boltzmann_machine.BoltzmannMachine.visible_bias:3 of
msgid "Number of visible nodes."
msgstr "可见节点数。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:1
#: of
msgid "Create a Gaussian-Bernoulli Restricted Boltzmann Machine."
msgstr "创建高斯-伯努利受限玻尔兹曼机。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:3
#: of
msgid ""
"A Gaussian-Bernoulli Restricted Boltzmann Machine has one Gaussian "
"partition and one Bernoulli partition. ``is_visible_gaussian`` indicates "
"whether the visible nodes correspond to the Gaussian side."
msgstr ""
"高斯-伯努利受限玻尔兹曼机（Gaussian-Bernoulli "
"RBM）包含一个高斯分区和一个伯努利分区。``is_visible_gaussian`` 指示可见节点是否对应高斯一侧。"

#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine:3
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:7
#: of
msgid "Number of visible nodes in the model."
msgstr "模型中的可见节点数。"

#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine:5
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:9
#: of
msgid "Number of hidden nodes in the model."
msgstr "模型中的隐藏节点数。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:11
#: of
msgid ""
"Whether visible nodes are Gaussian and hidden nodes are Bernoulli. "
"Defaults to True."
msgstr "可见节点是否为高斯分布、隐节点是否为伯努利分布。默认为 True。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:14
#: of
msgid "Small value to avoid numerical issues. Defaults to 1e-8."
msgstr "用于避免数值问题的小值。默认为 1e-8。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:17
#: of
msgid "Data type for tensor construction. Defaults to torch.float32."
msgstr "张量构建的数据类型。默认为 torch.float32。"

#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine:12
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine:20
#: of
msgid "Device to construct tensors."
msgstr "用于构造张量的设备。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.cd_gibbs_sample:1
#: of
msgid "Perform contrastive divergence Gibbs sampling."
msgstr "执行对比散度（CD）Gibbs 采样。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.cd_gibbs_sample:3
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.gibbs_sample:3
#: of
msgid "Number of Gibbs sampling steps to perform."
msgstr "要执行的 Gibbs 采样步数。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.cd_gibbs_sample:5
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.gibbs_sample:5
#: of
msgid "Number of initial steps to discard."
msgstr "需要丢弃的初始步数。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.cd_gibbs_sample:7
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.conditional_gibbs_sample:3
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_gaussian:3
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.marginal_energy:3
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.positive_phase_energy_expectation:3
#: of
msgid "State of Gaussian nodes."
msgstr "高斯节点的状态。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.cd_gibbs_sample:9
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.conditional_gibbs_sample:5
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_bernoulli:3
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.marginal_energy:5
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.positive_phase_energy_expectation:5
#: of
msgid "State of Bernoulli nodes."
msgstr "伯努利节点的状态。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.cd_gibbs_sample:12
#: of
msgid "Samples generated through CD Gibbs sampling."
msgstr "通过 CD Gibbs 采样生成的样本。"

#: ../../../../Users/chang137/Documents/kaiwu_torch_plugin_docs/docs/source/modules/kaiwu.torch_plugin.md
msgid "抛出"
msgstr "抛出"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.cd_gibbs_sample:15
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.conditional_gibbs_sample:14
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.positive_phase_energy_expectation:14
#: of
msgid ""
"If neither or both of s_gaussian and s_bernoulli are provided,     or if "
"input tensors have incorrect shapes."
msgstr "如果 s_gaussian 和 s_bernoulli 均未提供或同时提供，或输入张量形状不正确。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.conditional_gibbs_sample:1
#: of
msgid ""
"Perform conditional Gibbs sampling given either Gaussian or Bernoulli "
"nodes."
msgstr "在给定高斯节点或伯努利节点的条件下执行条件 Gibbs 采样。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.conditional_gibbs_sample:7
#: of
msgid "Whether to use deterministic sampling. Defaults to False."
msgstr "是否使用确定性采样。默认为 False。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.conditional_gibbs_sample:11
#: of
msgid "Samples with fixed nodes and sampled complementary nodes."
msgstr "包含固定节点与采样的互补节点的样本。"

#: kaiwu.torch_plugin.GaussianBernoulliRestrictedBoltzmannMachine.diag_precision:1
#: of
msgid "Diagonal precision matrix (inverse variance)."
msgstr "对角精度矩阵（方差的倒数）。"

#: kaiwu.torch_plugin.GaussianBernoulliRestrictedBoltzmannMachine.diag_precision
#: kaiwu.torch_plugin.GaussianBernoulliRestrictedBoltzmannMachine.std
#: kaiwu.torch_plugin.GaussianBernoulliRestrictedBoltzmannMachine.var of
msgid "type"
msgstr "类型"

#: kaiwu.torch_plugin.GaussianBernoulliRestrictedBoltzmannMachine.diag_precision:3
#: kaiwu.torch_plugin.GaussianBernoulliRestrictedBoltzmannMachine.std:3
#: kaiwu.torch_plugin.GaussianBernoulliRestrictedBoltzmannMachine.var:3 of
msgid "torch.tensor"
msgstr "torch.tensor"

#: kaiwu.torch_plugin.restricted_boltzmann_machine.RestrictedBoltzmannMachine.forward:3
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.energy:3
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.forward:3
#: of
msgid ""
"Tensor of shape (B, N), where B is the batch size, and N is the number of"
" variables in the model."
msgstr "形状为 (B, N) 的张量，其中 B 是批次大小，N 是模型中的变量数。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.energy:6
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.sampling_energy:27
#: of
msgid "Whether to enable gradient computation. Defaults to False."
msgstr "是否启用梯度计算。默认为 False。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.energy:13
#: of
msgid "If s_all is not a 2-D tensor or has inconsistent node numbers."
msgstr "如果 s_all 不是二维张量或节点数量不一致。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.gibbs_sample:1
#: of
msgid "Perform Gibbs sampling for the Gaussian-Bernoulli RBM."
msgstr "为高斯-伯努利 RBM 执行 Gibbs 采样。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.gibbs_sample:7
#: of
msgid "Whether to start with Gaussian or Bernoulli nodes."
msgstr "是否从高斯节点或伯努利节点开始。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.gibbs_sample:9
#: of
msgid "External sampler for initialization if provided."
msgstr "用于初始化的外部采样器（如果提供）。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.gibbs_sample:11
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.sample:25
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.sampling_energy:25
#: of
msgid "Number of samples to generate."
msgstr "要生成的样本数量。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.gibbs_sample:14
#: of
msgid "Samples generated through Gibbs sampling."
msgstr "通过 Gibbs 采样生成的样本。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.gibbs_sample:17
#: of
msgid "If starting conditions are invalid."
msgstr "如果起始条件无效。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_bernoulli:1
#: of
msgid "Sample according to given Bernoulli nodes."
msgstr "根据给定的伯努利节点采样。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_bernoulli:5
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_gaussian:8
#: of
msgid ""
"If True return optimal results, else return results with randomness. "
"Defaults to False."
msgstr "若为 True 返回最优结果，否则返回带随机性的结果。默认为 False。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_bernoulli:9
#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_gaussian:12
#: of
msgid "Complete state tensor with both Gaussian and Bernoulli nodes."
msgstr "同时包含高斯节点与伯努利节点的完整状态张量。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_bernoulli:12
#: of
msgid "If s_bernoulli is not a 2-D tensor or has inconsistent node numbers."
msgstr "如果 s_bernoulli 不是二维张量或节点数量不一致。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_gaussian:1
#: of
msgid "Sample according to given Gaussian nodes."
msgstr "根据给定的高斯节点采样。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_gaussian:5
#: of
msgid "If True return 0/1, else return probability. Defaults to True."
msgstr "若为 True 返回 0/1，否则返回概率。默认为 True。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.infer_from_gaussian:15
#: of
msgid "If s_gaussian is not a 2-D tensor or has inconsistent node numbers."
msgstr "如果 s_gaussian 不是二维张量或节点数量不一致。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.init_parameter:1
#: of
msgid "Initialize model parameters with normal distribution."
msgstr "使用正态分布初始化模型参数。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.init_parameter:3
#: of
msgid "Initial variance for Gaussian units. Defaults to 1."
msgstr "高斯单元的初始方差。默认为 1。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.init_parameter:6
#: of
msgid "Standard deviation for parameter initialization. Defaults to 0.01."
msgstr "参数初始化的标准差。默认为 0.01。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.init_parameter:9
#: of
msgid "Maximum factor for clipping parameters. Defaults to 16."
msgstr "参数裁剪的最大因子。默认为 16。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.marginal_energy:1
#: of
msgid "Compute the Free Hamiltonian of given Gaussian or Bernoulli nodes."
msgstr "计算给定高斯节点或伯努利节点的自由哈密顿量。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.marginal_energy:8
#: of
msgid "Free Hamiltonian of given Gaussian or Bernoulli nodes."
msgstr "给定高斯节点或伯努利节点的自由哈密顿量。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.marginal_energy:11
#: of
msgid ""
"If neither or both of s_gaussian and s_bernoulli are provided,     or if "
"the input tensors have incorrect shapes."
msgstr "如果 s_gaussian 和 s_bernoulli 均未提供或同时提供，或输入张量形状不正确。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.positive_phase_energy_expectation:1
#: of
msgid ""
"Compute the expectation of Hamiltonian with given Gaussian or Bernoulli "
"nodes."
msgstr "计算给定高斯节点或伯努利节点的哈密顿量期望。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.positive_phase_energy_expectation:7
#: of
msgid "Whether to enable gradient computation. Defaults to True."
msgstr "是否启用梯度计算。默认为 True。"

#: kaiwu.torch_plugin.restricted_gaussian_bernoulli_boltzmann_machine.GaussianBernoulliRestrictedBoltzmannMachine.positive_phase_energy_expectation:11
#: of
msgid "Expected Hamiltonian values."
msgstr "期望的哈密顿量值。"

