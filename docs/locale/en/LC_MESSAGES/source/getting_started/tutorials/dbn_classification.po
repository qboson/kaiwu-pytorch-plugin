#~ msgid "`n_epochs_rbm`：每层 RBM 训练轮数（默认 10）"
#~ msgstr "``n_epochs_rbm``: training epochs per RBM layer (default 10)"

#~ msgid "`batch_size`：批大小（默认 100）"
#~ msgstr "``batch_size``: mini-batch size (default 100)"

#~ msgid "`verbose`：打印训练信息（默认 True）"
