[MISCELLANEOUS]
# Maximum accepted argument counts
max-args=15
max-positional-arguments=15
max-attributes=30
max-locals=30
max-branches=15

[FORMAT]
# qdiffusion.py exceeds the default 1000-line limit once its Google-style
# docstrings were completed
max-module-lines=1200

[TYPECHECK]
ignored-classes=torch.nn.parameter.Parameter
disable=not-callable
